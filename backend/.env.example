# Hyundai Bluelink Canada credentials — never commit the real .env
BLUELINK_EMAIL=you@example.com
BLUELINK_PASSWORD=replace_me
BLUELINK_PIN=1234

# Bearer API key the iOS app will send. Generate a long random string (e.g. `openssl rand -hex 32`).
API_KEY=replace_with_random_hex

# Region + brand (defaults shown)
REGION=canada
BRAND=hyundai

# Optional: minimum seconds between forced live refreshes (default 600 = 10 min)
FORCE_REFRESH_MIN_INTERVAL_SECONDS=600

# Snapshot collector — polls Bluelink cached state (NEVER force-refresh) and persists to SQLite.
# Interval in seconds (default 900 = 15 min). Set lower for testing, higher to reduce load.
SNAPSHOT_INTERVAL_SECONDS=900
# Path to the SQLite file. In Docker this lives under the snapshot-data volume mount.
SNAPSHOT_DB_PATH=/data/snapshots.db

# Host interface for the published API port (default 127.0.0.1, loopback only).
# Cloudflare Tunnel does not need it. Set to the VM's Tailscale IP or 0.0.0.0 only
# while migrating from direct/Tailscale access, then remove it.
# BACKEND_BIND_ADDRESS=127.0.0.1

# Bluelink login backoff after failures (seconds). Doubles per failed attempt up to the max,
# resets on success. Keeps a broken login from hammering Hyundai's auth endpoint (HTTP 429).
LOGIN_BACKOFF_INITIAL_SECONDS=900
LOGIN_BACKOFF_MAX_SECONDS=21600
